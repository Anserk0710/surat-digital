# ============================================================
# Application runtime
# ============================================================

NODE_ENV=development
PORT=3000

# ============================================================
# P02 Database — Prisma/Supabase
# ============================================================

# Runtime application role.
#
# Untuk serverless:
# Supabase Transaction Pooler / surat_runtime.
#
# Contoh:
# postgresql://surat_runtime.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&uselibpqcompat=true&sslmode=require
DATABASE_URL=

# Prisma CLI/Migrate/Seed role: dedicated relation owner.
#
# Prefer direct connection jika environment mendukung IPv6.
# Session pooler port 5432 dapat digunakan jika direct endpoint
# tidak dapat dijangkau dari IPv4.
#
# Contoh:
# postgresql://surat_migrator.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?uselibpqcompat=true&sslmode=require
DIRECT_URL=

# Proteksi operasi database reset.
# Aktifkan hanya saat menjalankan reset database lokal.
ALLOW_LOCAL_DB_RESET=false

# Nama database yang diizinkan untuk di-reset.
LOCAL_DB_RESET_DATABASE=surat_digital_dev

# Expected PostgreSQL migration role.
P02_MIGRATION_ROLE_NAME=surat_migrator

# HANYA untuk prisma migrate dev/create.
#
# WAJIB menunjuk DB shadow disposable.
# JANGAN production.
# JANGAN staging utama.
SHADOW_DATABASE_URL=

# Expected PostgreSQL runtime role.
P02_RUNTIME_ROLE_NAME=surat_runtime

# ============================================================
# P03 — Auth Gateway
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hanya diperlukan oleh verification/admin tooling.
# Browser tidak boleh menerima variable ini.

FRONTEND_ORIGIN=http://localhost:5173

# Opaque application session cookie.
AUTH_SESSION_COOKIE_NAME=sd_session

# 7 hari.
AUTH_SESSION_MAX_AGE_SECONDS=604800

# false hanya untuk local HTTP.
# staging/production wajib true.
AUTH_COOKIE_SECURE=false

# lax | strict | none
# none wajib AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAME_SITE=lax

# Harus random 32 byte dalam Base64.
AUTH_TOKEN_ENCRYPTION_KEY_BASE64=

# Opsional: hanya untuk deployment dengan satu trusted company.
# Jangan mengambil nilai ini dari request body login.
AUTH_DEFAULT_COMPANY_ID=

# P04
# Random 32-byte key, encoded as Base64.
AUTH_RATE_LIMIT_HMAC_KEY_BASE64=

# Random 32-byte CSRF signing key, encoded as Base64.
# Must differ from encryption/rate-limit keys.
AUTH_CSRF_SECRET_BASE64=

# Number of trusted reverse-proxy hops.
# 0 = do not trust proxy-provided client IP.
AUTH_TRUST_PROXY_HOPS=0

# ============================================================
# P05 — Development organization
# ============================================================

P05_DEV_SEED_ACK=
P05_DEV_COMPANY_CODE=CIM
P05_DEV_COMPANY_NAME=PT CIM (Development)

# Optional: UUID employee yang boleh mendapat DEV_ORG_ADMIN.
P05_DEV_ADMIN_EMPLOYEE_ID=

# Proteksi integration verifier P05.
P05_NONPROD_ACK=
P05_EXPECTED_DATABASE_NAME=

# P06 — Development only.
P06_DEV_SEED_ACK=
P06_DEV_ADMIN_EMPLOYEE_ID=
P06_EXPECTED_DATABASE_NAME=

# Proteksi integration verifier P06.
P06_NONPROD_ACK=

# ============================================================
# P07 — RLS Runtime POC
# ============================================================

# Wajib YES untuk menjalankan verifier P07.
# Tidak boleh digunakan terhadap production.
P07_NONPROD_ACK=

# Nama database yang secara eksplisit diizinkan
# untuk P07 integration/benchmark.
P07_EXPECTED_DATABASE_NAME=

# Jumlah sample benchmark setelah warm-up.
# Minimum verifier = 20, maksimum = 1000.
P07_BENCHMARK_ITERATIONS=100

# ============================================================
# P08 — Document Master
# ============================================================

# Integration verifier hanya boleh terhadap non-production DB.
P08_NONPROD_ACK=
P08_EXPECTED_DATABASE_NAME=

# Optional development-only master data.
P08_DEV_SEED_ACK=

# P09: development defaults to local private storage; production requires Vercel private Blob.
FILE_STORAGE_DRIVER=
# Vercel supplies BLOB_STORE_ID + VERCEL_OIDC_TOKEN, or use a server-only token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Integration verifier only against a non-production database.
P09_NONPROD_ACK=
P09_EXPECTED_DATABASE_NAME=

P04_NONPROD_ACK=
WEB_NONPROD_ACK=
WEB_EXPECTED_DATABASE_NAME=
