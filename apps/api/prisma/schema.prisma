generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum DocumentStatus {
  DRAFT
  PENDING_ACKNOWLEDGMENT
  PENDING_APPROVAL
  IN_PROGRESS
  FINALIZING
  REJECTED
  CANCELLED
  ISSUED
  ARCHIVED
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique(map: "companies_code_key") @db.VarChar(50)
  name      String   @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  offices        Office[]
  divisions      Division[]
  jobTitles      JobTitle[]
  employees      Employee[]
  groups         Group[]
  documents      Document[]
  storageObjects StorageObject[]

  @@map("companies")
}

model Office {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  timezone  String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "offices_company_id_fkey")

  officeDivisions OfficeDivision[]
  rlsPocResources RlsPocResource[]
  issuedDocuments Document[]       @relation("DocumentIssuerOffice")

  @@unique([companyId, code], map: "offices_company_id_code_key")
  @@index([companyId], map: "offices_company_id_idx")
  @@map("offices")
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "divisions_company_id_fkey")

  officeDivisions OfficeDivision[]
  issuedDocuments Document[]       @relation("DocumentIssuerDivision")

  @@unique([companyId, code], map: "divisions_company_id_code_key")
  @@index([companyId], map: "divisions_company_id_idx")
  @@map("divisions")
}

model OfficeDivision {
  id         String   @id @default(uuid()) @db.Uuid
  officeId   String   @map("office_id") @db.Uuid
  divisionId String   @map("division_id") @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  office   Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "office_divisions_office_id_fkey")
  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "office_divisions_division_id_fkey")

  employeeAssignments EmployeeAssignment[]
  issuedDocuments     Document[]           @relation("DocumentIssuerScope")

  @@unique([officeId, divisionId], map: "office_divisions_office_id_division_id_key")
  @@index([divisionId], map: "office_divisions_division_id_idx")
  @@map("office_divisions")
}

model JobTitle {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "job_titles_company_id_fkey")

  employeeAssignments EmployeeAssignment[]

  @@unique([companyId, code], map: "job_titles_company_id_code_key")
  @@index([companyId], map: "job_titles_company_id_idx")
  @@map("job_titles")
}

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  authUserId         String?        @unique(map: "employees_auth_user_id_key") @map("auth_user_id") @db.Uuid
  employeeNumber     String         @map("employee_number") @db.VarChar(100)
  username           String         @db.VarChar(100)
  usernameNormalized String         @map("username_normalized") @db.VarChar(100)
  email              String         @db.VarChar(320)
  emailNormalized    String         @map("email_normalized") @db.VarChar(320)
  fullName           String         @map("full_name") @db.VarChar(200)
  status             EmployeeStatus @default(PENDING)
  isPlatformAdmin    Boolean        @default(false) @map("is_platform_admin")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employees_company_id_fkey")

  assignments    EmployeeAssignment[]
  employeeGroups EmployeeGroup[]
  authSessions   AuthSession[]

  rlsPocResources         RlsPocResource[]  @relation("RlsPocResourceOwner")
  createdDocuments        Document[]        @relation("DocumentCreator")
  createdDocumentVersions DocumentVersion[] @relation("DocumentVersionCreator")
  uploadedDocumentFiles   DocumentFile[]    @relation("DocumentFileUploader")
  uploadedStorageObjects  StorageObject[]   @relation("StorageObjectUploader")

  @@unique([companyId, employeeNumber], map: "employees_company_id_employee_number_key")
  @@unique([companyId, usernameNormalized], map: "employees_company_id_username_normalized_key")
  @@unique([companyId, emailNormalized], map: "employees_company_id_email_normalized_key")
  @@index([companyId], map: "employees_company_id_idx")
  @@index([companyId, status], map: "employees_company_id_status_idx")
  @@map("employees")
}

model EmployeeAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  officeDivisionId String    @map("office_division_id") @db.Uuid
  jobTitleId       String?   @map("job_title_id") @db.Uuid
  isPrimary        Boolean   @default(false) @map("is_primary")
  validFrom        DateTime? @map("valid_from") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_assignments_employee_id_fkey")
  officeDivision OfficeDivision @relation(fields: [officeDivisionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_assignments_office_division_id_fkey")
  jobTitle       JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_assignments_job_title_id_fkey")

  @@index([employeeId], map: "employee_assignments_employee_id_idx")
  @@index([officeDivisionId], map: "employee_assignments_office_division_id_idx")
  @@index([jobTitleId], map: "employee_assignments_job_title_id_idx")
  @@map("employee_assignments")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String   @db.VarChar(100)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "groups_company_id_fkey")

  employeeGroups   EmployeeGroup[]
  groupPermissions GroupPermission[]

  @@unique([companyId, code], map: "groups_company_id_code_key")
  @@index([companyId], map: "groups_company_id_idx")
  @@map("groups")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "permissions_code_key") @db.VarChar(150)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  groupPermissions GroupPermission[]

  @@map("permissions")
}

model EmployeeGroup {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_groups_employee_id_fkey")
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "employee_groups_group_id_fkey")

  @@unique([employeeId, groupId], map: "employee_groups_employee_id_group_id_key")
  @@index([groupId], map: "employee_groups_group_id_idx")
  @@map("employee_groups")
}

model GroupPermission {
  id           String           @id @default(uuid()) @db.Uuid
  groupId      String           @map("group_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "group_permissions_group_id_fkey")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "group_permissions_permission_id_fkey")

  @@unique([groupId, permissionId], map: "group_permissions_group_id_permission_id_key")
  @@index([permissionId], map: "group_permissions_permission_id_idx")
  @@map("group_permissions")
}

model AuthSession {
  id                     String    @id @default(uuid()) @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  supabaseUserId         String    @map("supabase_user_id") @db.Uuid
  supabaseSessionId      String    @unique(map: "auth_sessions_supabase_session_id_key") @map("supabase_session_id") @db.Uuid
  sessionTokenHash       String    @unique(map: "auth_sessions_session_token_hash_key") @map("session_token_hash") @db.Char(64)
  accessTokenCiphertext  String    @map("access_token_ciphertext") @db.Text
  refreshTokenCiphertext String    @map("refresh_token_ciphertext") @db.Text
  accessTokenExpiresAt   DateTime  @map("access_token_expires_at") @db.Timestamptz(6)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  lastRefreshedAt        DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  refreshLeaseId         String?   @map("refresh_lease_id") @db.Uuid
  refreshLeaseUntil      DateTime? @map("refresh_lease_until") @db.Timestamptz(6)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "auth_sessions_employee_id_fkey")

  @@index([employeeId], map: "auth_sessions_employee_id_idx")
  @@index([supabaseUserId], map: "auth_sessions_supabase_user_id_idx")
  @@index([revokedAt, expiresAt], map: "auth_sessions_revoked_at_expires_at_idx")
  @@map("auth_sessions")
}

model AuthRateLimitBucket {
  id           String   @id @db.VarChar(64)
  requestCount Int      @default(0) @map("request_count")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "auth_rate_limit_buckets_expires_at_idx")
  @@map("auth_rate_limit_buckets")
}

model GroupPolicyAudit {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  actorEmployeeId String   @map("actor_employee_id") @db.Uuid
  action          String   @db.VarChar(60)
  targetType      String   @map("target_type") @db.VarChar(40)
  targetId        String   @map("target_id") @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([companyId, occurredAt], map: "group_policy_audit_company_time_idx")
  @@map("group_policy_audit")
}

model OrganizationChange {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  actorEmployeeId String   @map("actor_employee_id") @db.Uuid
  action          String   @db.VarChar(20)
  targetType      String   @map("target_type") @db.VarChar(40)
  targetId        String   @map("target_id") @db.Uuid
  before          Json?
  after           Json?
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([companyId, targetType, targetId, occurredAt], map: "organization_changes_target_time_idx")
  @@map("organization_changes")
}

model RlsPocResource {
  id              String   @id @default(uuid()) @db.Uuid
  ownerEmployeeId String   @map("owner_employee_id") @db.Uuid
  officeId        String   @map("office_id") @db.Uuid
  label           String   @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ownerEmployee Employee @relation("RlsPocResourceOwner", fields: [ownerEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rls_poc_resources_owner_employee_id_fkey")
  office        Office   @relation(fields: [officeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "rls_poc_resources_office_id_fkey")

  @@index([ownerEmployeeId], map: "rls_poc_resources_owner_employee_id_idx")
  @@index([officeId], map: "rls_poc_resources_office_id_idx")
  @@map("rls_poc_resources")
}

model DocumentType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique(map: "document_types_code_key") @db.VarChar(50)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subtypes  DocumentSubtype[]
  documents Document[]        @relation("DocumentType")

  @@map("document_types")
}

model DocumentSubtype {
  id             String   @id @default(uuid()) @db.Uuid
  documentTypeId String   @map("document_type_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(200)
  description    String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "document_subtypes_document_type_id_fkey")

  documents Document[] @relation("DocumentSubtype")

  @@unique([documentTypeId, code], map: "document_subtypes_document_type_id_code_key")
  // Diperlukan untuk composite FK pada documents agar kombinasi
  // type/subtype juga dijaga database, bukan hanya service.
  @@unique([id, documentTypeId], map: "document_subtypes_id_document_type_id_key")
  @@index([documentTypeId], map: "document_subtypes_document_type_id_idx")
  @@map("document_subtypes")
}

model Document {
  id                String         @id @default(uuid()) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  documentTypeId    String         @map("document_type_id") @db.Uuid
  documentSubtypeId String         @map("document_subtype_id") @db.Uuid
  creatorEmployeeId String         @map("creator_employee_id") @db.Uuid
  issuerDivisionId  String         @map("issuer_division_id") @db.Uuid
  issuerOfficeId    String         @map("issuer_office_id") @db.Uuid
  title             String         @db.VarChar(300)
  description       String?        @db.Text
  status            DocumentStatus @default(DRAFT)

  // Optimistic concurrency untuk metadata row.
  // Ini BUKAN document_versions.version_no.
  revision Int @default(1)

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(6)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  rejectionReason String? @map("rejection_reason") @db.Text
  withdrawReason  String? @map("withdraw_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "documents_company_id_fkey")
  documentType    DocumentType      @relation("DocumentType", fields: [documentTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "documents_document_type_id_fkey")
  // Composite relation ini memastikan subtype benar-benar
  // berasal dari type yang dipilih.
  documentSubtype DocumentSubtype   @relation("DocumentSubtype", fields: [documentSubtypeId, documentTypeId], references: [id, documentTypeId], onDelete: Restrict, onUpdate: Cascade, map: "documents_document_subtype_type_fkey")
  creator         Employee          @relation("DocumentCreator", fields: [creatorEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "documents_creator_employee_id_fkey")
  issuerOffice    Office            @relation("DocumentIssuerOffice", fields: [issuerOfficeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "documents_issuer_office_id_fkey")
  issuerDivision  Division          @relation("DocumentIssuerDivision", fields: [issuerDivisionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "documents_issuer_division_id_fkey")
  // Memastikan Office + Division memang pasangan OfficeDivision valid.
  issuerScope     OfficeDivision    @relation("DocumentIssuerScope", fields: [issuerOfficeId, issuerDivisionId], references: [officeId, divisionId], onDelete: Restrict, onUpdate: Cascade, map: "documents_issuer_scope_fkey")
  versions        DocumentVersion[]

  @@index([companyId, status, createdAt], map: "documents_company_id_status_created_at_idx")
  @@index([creatorEmployeeId, status, createdAt], map: "documents_creator_status_created_at_idx")
  @@index([documentTypeId, documentSubtypeId], map: "documents_type_subtype_idx")
  @@index([issuerOfficeId, issuerDivisionId], map: "documents_issuer_scope_idx")
  @@map("documents")
}

model DocumentVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  documentId          String   @map("document_id") @db.Uuid
  versionNo           Int      @map("version_no")
  sourceMethod        String   @default("UPLOAD") @map("source_method") @db.VarChar(20)
  createdByEmployeeId String   @map("created_by_employee_id") @db.Uuid
  isLocked            Boolean  @default(false) @map("is_locked")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document       @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "document_versions_document_id_fkey")
  creator  Employee       @relation("DocumentVersionCreator", fields: [createdByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "document_versions_created_by_employee_id_fkey")
  files    DocumentFile[]

  @@unique([documentId, versionNo], map: "document_versions_document_id_version_no_key")
  @@index([documentId], map: "document_versions_document_id_idx")
  @@map("document_versions")
}

model StorageObject {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @map("company_id") @db.Uuid
  uploadedByEmployeeId String   @map("uploaded_by_employee_id") @db.Uuid
  provider             String   @db.VarChar(20)
  pathname             String   @unique(map: "storage_objects_pathname_key") @db.VarChar(500)
  contentType          String   @map("content_type") @db.VarChar(150)
  sizeBytes            Int      @map("size_bytes")
  sha256               String   @db.Char(64)
  accessMode           String   @default("PRIVATE") @map("access_mode") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  files    DocumentFile[]
  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploader Employee       @relation("StorageObjectUploader", fields: [uploadedByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("storage_objects")
}

model DocumentFile {
  id                   String   @id @default(uuid()) @db.Uuid
  documentVersionId    String   @map("document_version_id") @db.Uuid
  storageObjectId      String   @map("storage_object_id") @db.Uuid
  uploadedByEmployeeId String   @map("uploaded_by_employee_id") @db.Uuid
  fileRole             String   @map("file_role") @db.VarChar(20)
  originalFilename     String   @map("original_filename") @db.VarChar(255)
  detectedMime         String   @map("detected_mime") @db.VarChar(150)
  sizeBytes            Int      @map("size_bytes")
  sha256               String   @db.Char(64)
  processingStatus     String   @default("UPLOADED") @map("processing_status") @db.VarChar(30)
  reviewStatus         String   @default("PENDING") @map("review_status") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version       DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "document_files_document_version_id_fkey")
  storageObject StorageObject   @relation(fields: [storageObjectId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "document_files_storage_object_id_fkey")
  uploader      Employee        @relation("DocumentFileUploader", fields: [uploadedByEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "document_files_uploaded_by_employee_id_fkey")

  @@unique([storageObjectId], map: "document_files_storage_object_id_key")
  @@index([documentVersionId, createdAt], map: "document_files_version_created_at_idx")
  @@map("document_files")
}
