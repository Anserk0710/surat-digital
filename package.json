{
  "name": "surat-digital",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-toolchain.mjs",
    "p00:validate": "node scripts/p00-validate.mjs",
    "p00:check": "npm run p00:validate",
    "p00:frontend": "node scripts/verify-p00-frontend.mjs",
    "p00:expand-trace": "node scripts/expand-p00-trace.mjs",
    "p02:frontend": "node scripts/verify-p02-frontend.mjs",
    "p02:verify:clean-migration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-p02-clean-migration.ps1",
    "p02:verify:backend": "node scripts/verify-p02-backend.mjs",
    "p03:verify": "node scripts/verify-p03.mjs",
    "web:verify:browser": "tsx --tsconfig apps/api/tsconfig.json scripts/verify-web-browser.ts",
    "web:verify:smoke": "node scripts/verify-web-smoke.mjs",
    "web:cleanup:fixtures": "tsx --tsconfig apps/api/tsconfig.json scripts/cleanup-web-fixtures.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc6 --noEmit -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:spec": "npm run --workspace=@surat-digital/api openapi:generate && prettier --write packages/api-contracts/openapi.json",
    "api:types": "npm run --workspace=@surat-digital/api-client generate:types",
    "api:contract": "npm run prisma:generate && npm run api:spec && npm run api:types && npm run --workspace=@surat-digital/api-client build",
    "api:contract:check": "node scripts/check-generated-api-contract.mjs",
    "prisma:generate": "npm run --workspace=@surat-digital/api prisma:generate",
    "prisma:validate": "npm run --workspace=@surat-digital/api prisma:validate",
    "prisma:format": "npm run --workspace=@surat-digital/api prisma:format",
    "pretypecheck": "npm run prisma:generate && npm run --workspace=@surat-digital/api-client build",
    "prebuild": "npm run prisma:generate && npm run --workspace=@surat-digital/api-client build",
    "db:migrate:create": "node scripts/require-db-env.mjs DIRECT_URL && npm run --workspace=@surat-digital/api db:migrate:create --",
    "db:migrate:dev": "node scripts/require-db-env.mjs DIRECT_URL && npm run --workspace=@surat-digital/api db:migrate:dev --",
    "db:migrate:deploy": "node scripts/require-db-env.mjs DIRECT_URL && npm run --workspace=@surat-digital/api db:migrate:deploy",
    "db:migrate:status": "node scripts/require-db-env.mjs DIRECT_URL && npm run --workspace=@surat-digital/api db:migrate:status",
    "db:migrate:diff": "npm run --workspace=@surat-digital/api db:migrate:diff",
    "db:seed": "node scripts/require-db-env.mjs DIRECT_URL && npm run --workspace=@surat-digital/api db:seed",
    "db:verify:seed": "npm run --workspace=@surat-digital/api db:verify:seed",
    "db:verify:runtime-role": "npm run --workspace=@surat-digital/api db:verify:runtime-role",
    "db:smoke": "npm run --workspace=@surat-digital/api db:smoke",
    "db:reset:local": "node scripts/assert-local-database.mjs && npm run --workspace=@surat-digital/api db:reset && npm run db:seed",
    "ci": "npm run api:contract:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "p01:verify:fresh-install": "node scripts/p01-verify-fresh-install.mjs",
    "p04:verify": "node scripts/verify-p04.mjs",
    "p04:verify:integration": "node scripts/verify-p04.mjs --integration",
    "p05:verify": "node scripts/verify-p05.mjs",
    "p05:verify:integration": "node scripts/verify-p05.mjs --integration",
    "p06:verify": "node scripts/verify-p06.mjs",
    "p06:verify:integration": "node scripts/verify-p06.mjs --integration",
    "p07:verify": "node scripts/verify-p07.mjs",
    "p07:verify:integration": "node scripts/verify-p07.mjs --integration",
    "verify:pre-p04": "node scripts/verify-pre-p04.mjs",
    "verify:pre-p04:integration": "node scripts/verify-pre-p04.mjs --integration"
  },
  "packageManager": "npm@12.2.2",
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/document-worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": "12.2.x"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.60.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
