{
  "name": "@surat-digital/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:types": "openapi-typescript ../api-contracts/openapi.json -o src/generated/openapi.ts && prettier --write src/generated/openapi.ts",
    "build": "tsc6 -p tsconfig.build.json",
    "typecheck": "tsc6 --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
